generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model todos {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(255)
  completed  Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}
